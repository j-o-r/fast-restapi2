 {
      "compilerOptions": {
        "allowJs": true,
        "declaration": true,
        "emitDeclarationOnly": true,
        "outDir": "./types",
        "rootDir": "./lib",
        "strict": true,
        "module": "NodeNext",
        "target": "es2022",
        "moduleResolution": "nodenext",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true
      },
      "include": ["lib/**/*.js"],
      "exclude": ["node_modules"]
    }
